# Set these environment variables in your shell; this file is not auto-loaded.
INTERNAL_API_TOKEN=replace-with-a-long-random-secret
DATABASE_PATH=./data/notifications.db
ALLOWED_ORIGINS=http://127.0.0.1:9001
MAX_ATTEMPTS=5
REQUEST_TIMEOUT=10
CONNECT_TIMEOUT=3
LEASE_SECONDS=30
POLL_SECONDS=1
WORKER_CONCURRENCY=5
RETRY_BASE_SECONDS=5
DB_BUSY_SECONDS=2
